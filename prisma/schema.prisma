// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique @default(uuid()) @map("public_id") @db.Uuid
  peladeiroId     Int      @unique @map("peladeiro_id")
  username        String   @db.VarChar(50)
  email           String   @unique @db.VarChar(50)
  password        String   @db.VarChar(255)
  isActive        Boolean  @default(false) @map("is_active")
  dataCadastro    DateTime @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  peladeiro Peladeiro @relation(fields: [peladeiroId], references: [id]) // Definição de relacionamento com a Entidade Peladeiro

  @@map("usuarios")
}

enum StatusPeladeiro {
  ATIVO
  INATIVO
  DEPARTAMENTO_MEDICO
  SUSPENSO
  PROIBIDO
}

enum FuncaoTatica {
  GOLEIRO
  ZAGUEIRO
  MEIO_CAMPO
  ATACANTE
}

/**
 * Entidade que armazena os peladeiros.
 */
model Peladeiro {
  id              Int             @id @default(autoincrement())
  publicId        String          @unique @default(uuid()) @map("public_id") @db.Uuid
  nomeCompleto    String          @map("nome_completo") @db.VarChar(150)
  nomeCamisa      String          @map("nome_camisa") @db.VarChar(30)
  numeroCamisa    Int?            @map("numero_camisa")
  funcaoTatica    FuncaoTatica?   @map("funcao_tatica")
  slug            String          @unique @db.VarChar(100)
  imagem          String?         @db.VarChar(500)
  status          StatusPeladeiro @default(ATIVO)
  dataNascimento  DateTime?       @map("data_nascimento")
  dataCadastro    DateTime        @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime        @updatedAt @map("data_atualizacao")

  usuario Usuario? // Relacionamento reverso com o usuário

  relacionamentos PeladeiroVinculo[] // Relacionamento reverso com a Entidade PeladeiroVinculo, retornando os N vímulos do peladeiro

  @@map("peladeiros")
}

enum TipoVinculoPeladeiro {
  FILIADO
  MENSALISTA
  CONVIDADO
}

/**
 * Mantém o vinculo do peladeiro com a pelada (filiado, mensalista, convidado).
 */
model PeladeiroVinculo {
  id              Int                  @id @default(autoincrement())
  peladeiroId     Int                  @map("peladeiro_id")
  tipo            TipoVinculoPeladeiro
  dataInicio      DateTime             @map("data_inicio")
  dataFim         DateTime?            @map("data_fim")
  dataCadastro    DateTime             @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime             @updatedAt @map("data_atualizacao")

  peladeiro Peladeiro @relation(fields: [peladeiroId], references: [id]) // Definição de relacionamento com a Entidade Peladeiro

  @@index([peladeiroId])
  @@map("peladeiro_vinculos")
}

enum StatusEvento {
  AGENDADO
  INICIADO
  ENCERRADO
  CANCELADO
}

/**
 * Tabela que armazena os eventos da pelada (Futebol, Torneio, Churrasco, etc).
 */
model Evento {
  id              Int          @id @default(autoincrement())
  nome            String       @db.VarChar(150)
  local           String       @db.VarChar(150)
  dataInicio      DateTime     @map("data_inicio")
  dataFim         DateTime?    @map("data_fim")
  status          StatusEvento @default(AGENDADO)
  dataCadastro    DateTime     @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime     @updatedAt @map("data_atualizacao")

  jogadores     PeladeiroEvento[]
  times         Time[]
  partidas      Partida[]
  movimentacoes CaixaMovimentacao[]

  @@map("eventos")
}

enum StatusPeladeiroEvento {
  ESCALAVEL
  NAO_ESCALAVEL
}

/**
 * Relacionamento entre o peladeiro e o evento.
 * Basicamente é a relação da órdem de chegada dos peladeiros no evento.
 */
model PeladeiroEvento {
  id              Int                   @id @default(autoincrement())
  peladeiroId     Int                   @map("peladeiro_id")
  eventoId        Int                   @map("evento_id")
  status          StatusPeladeiroEvento @default(ESCALAVEL)
  registroEntrada DateTime              @map("registro_entrada")
  registroSaida   DateTime?             @map("registro_saida")
  dataCadastro    DateTime              @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime              @updatedAt @map("data_atualizacao")

  @@map("peladeiro_eventos")
}

enum TipoCaixaMovimentacao {
  ENTRADA
  SAIDA
}

/**
 * Tabela que armazena as movimentações do caixa da pelada.
 */
model CaixaMovimentacao {
  id               Int                   @id @default(autoincrement())
  eventoId         Int                   @map("evento_id")
  peladeiroId      Int                   @map("peladeiro_id")
  tipo             TipoCaixaMovimentacao
  descricao        String                @db.VarChar(255)
  valor            Decimal               @db.Decimal(10, 2)
  dataMovimentacao DateTime              @map("data_movimentacao")
  dataCadastro     DateTime              @default(now()) @map("data_cadastro")
  dataAtualizacao  DateTime              @updatedAt @map("data_atualizacao")

  @@map("caixa_movimentacoes")
}

enum StatusMaterial {
  NOVO
  BOM
  REGULAR
  DANIFICADO
  EM_MANUTENCAO
  INSERVIVEL
  EXTRAVIADO
  BAIXADO
}

/**
 * Tabela que armazena os materiais da pelada.
 */
model Material {
  id                  Int             @id @default(autoincrement())
  caixaMovimentacaoId Int             @map("caixa_movimentacao_id")
  nome                String          @db.VarChar(150)
  descricao           String          @db.VarChar(255)
  status              StatusMaterial?
  dataAquisicao       DateTime?       @map("data_aquisicao")
  dataCadastro        DateTime        @default(now()) @map("data_cadastro")
  dataAtualizacao     DateTime        @updatedAt @map("data_atualizacao")

  @@map("materiais")
}

/**
 * Representa a lista de times do evento.
 */
model Time {
  id               Int      @id @default(autoincrement())
  publicId         String   @unique @default(uuid()) @map("public_id") @db.Uuid
  nome             String   @db.VarChar(150)
  imagem           String?  @db.VarChar(500)
  dataCadastro     DateTime @default(now()) @map("data_cadastro")
  data_atualizacao DateTime @default(now()) @map("data_atualizacao")

  @@map("times")
}

/**
 * Tabela que relaciona os peladeiros do evento com seus respectivos times durante o evento.
 * O peladeiro poder ser escalado em vários times durante o evento. Mas em apenas um time ativo por vez.
 */
model PeladeiroEventoTime {
  id                Int      @id @default(autoincrement())
  timeId            Int      @map("time_id")
  PeladeiroEventoId Int      @map("peladeiro_evento_id")
  dataCadastro      DateTime @default(now()) @map("data_cadastro")
  dataAtualizacao   DateTime @default(now()) @map("data_atualizacao")

  @@map("peladeiro_evento_times")
}

enum StatusPartida {
  AGUARDANDO
  PAUSADA
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

model Partida {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  eventoId Int @map("evento_id")

  numero Int?
  status StatusPartida @default(AGUARDANDO)

  inicio DateTime?
  fim    DateTime?

  duracaoMinutos Int? @map("duracao_minutos")

  dataCadastro    DateTime @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  evento    Evento           @relation(fields: [eventoId], references: [id])
  times     PartidaTime[]
  jogadores PartidaJogador[]
  gols      Gol[]

  @@index([eventoId])
  @@map("partidas")
}

enum CorColete {
  AZUL
  PRETO
}

model PartidaTime {
  id        Int       @id @default(autoincrement())
  partidaId Int       @map("partida_id")
  timeId    Int       @map("time_id")
  corColete CorColete

  gols Int @default(0)

  partida Partida @relation(fields: [partidaId], references: [id])
  time    Time    @relation(fields: [timeId], references: [id])

  @@unique([partidaId, timeId])
  @@unique([partidaId, lado])
  @@index([timeId])
  @@map("partidas_times")
}

model PartidaJogador {
  id                Int @id @default(autoincrement())XZ B Z BXXV B C  B NBVG     VC IYIKJ0, 
  3VV,  

  partidaId         Int @map("partida_id")
  peladeiroEventoId Int @map("peladeiro_evento_id")
  timeId            Int @map("time_id")

  titular Boolean @default(true)

  partida         Partida         @relation(fields: [partidaId], references: [id])
  peladeiroEvento PeladeiroEvento @relation(fields: [peladeiroEventoId], references: [id])
  time            Time            @relation(fields: [timeId], references: [id])

  gols         Gol[] @relation("Artilheiro")
  assistencias Gol[] @relation("Assistente")

  @@unique([partidaId, peladeiroEventoId])
  @@index([partidaId])
  @@index([peladeiroEventoId])
  @@index([timeId])
  @@map("partidas_jogadores")
}
