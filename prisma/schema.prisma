// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique @default(uuid()) @map("public_id") @db.Uuid
  peladeiroId     Int      @unique @map("peladeiro_id")
  username        String   @db.VarChar(50)
  email           String   @unique @db.VarChar(50)
  password        String   @db.VarChar(255)
  isActive        Boolean  @default(false) @map("is_active")
  dataCadastro    DateTime @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  peladeiro Peladeiro @relation(fields: [peladeiroId], references: [id]) // Definição de relacionamento com a Entidade Peladeiro

  @@map("usuarios")
}

enum StatusPeladeiro {
  ATIVO
  INATIVO
  DEPARTAMENTO_MEDICO
  SUSPENSO
  PROIBIDO
}

enum FuncaoTatica {
  GOLEIRO
  ZAGUEIRO
  MEIO_CAMPO
  ATACANTE
}

/**
 * Entidade que armazena os peladeiros.
 */
model Peladeiro {
  id              Int             @id @default(autoincrement())
  publicId        String          @unique @default(uuid()) @map("public_id") @db.Uuid
  nomeCompleto    String          @map("nome_completo") @db.VarChar(150)
  nomeCamisa      String          @map("nome_camisa") @db.VarChar(30)
  numeroCamisa    Int?            @map("numero_camisa")
  funcaoTatica    FuncaoTatica?   @map("funcao_tatica")
  slug            String          @unique @db.VarChar(100)
  imagem          String?         @db.VarChar(500)
  status          StatusPeladeiro @default(ATIVO)
  dataNascimento  DateTime?       @map("data_nascimento")
  dataCadastro    DateTime        @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime        @updatedAt @map("data_atualizacao")

  usuario Usuario? // Relacionamento reverso com o usuário

  vinculos PeladeiroVinculo[] // Relacionamento reverso com a Entidade PeladeiroVinculo, retornando os N vímulos do peladeiro

  eventos PeladeiroEvento[] // Relacionamento reverso com a Entidade PeladeiroEvento, retornando os N relacionamento com Eventos e Peladeiros

  caixaMovimentacoes CaixaMovimentacao[] // Relacionamento reverso com a Entidade CaixaMovimentacao, retornando os N movimentações financeiras do peladeiro

  @@map("peladeiros")
}

enum TipoVinculoPeladeiro {
  FILIADO
  MENSALISTA
  CONVIDADO
}

/**
 * Mantém o vinculo do peladeiro com a pelada (filiado, mensalista, convidado).
 */
model PeladeiroVinculo {
  id              Int                  @id @default(autoincrement())
  peladeiroId     Int                  @map("peladeiro_id")
  tipo            TipoVinculoPeladeiro
  dataInicio      DateTime             @map("data_inicio")
  dataFim         DateTime?            @map("data_fim")
  dataCadastro    DateTime             @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime             @updatedAt @map("data_atualizacao")

  peladeiro Peladeiro @relation(fields: [peladeiroId], references: [id]) // Definição de relacionamento com a Entidade Peladeiro

  @@index([peladeiroId])
  @@map("peladeiro_vinculos")
}

enum StatusEvento {
  AGENDADO
  INICIADO
  ENCERRADO
  CANCELADO
}

enum TipoEvento {
  PELADA
  TORNEIRO
}

/**
 * Tabela que armazena os eventos da pelada (Futebol, Torneio, Churrasco, etc).
 */
model Evento {
  id              Int          @id @default(autoincrement())
  nome            String       @db.VarChar(150)
  local           String       @db.VarChar(150)
  status          StatusEvento @default(AGENDADO)
  tipoEvento      TipoEvento   @default(TORNEIRO)
  dataInicio      DateTime     @map("data_inicio")
  dataFim         DateTime?    @map("data_fim")
  dataCadastro    DateTime     @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime     @updatedAt @map("data_atualizacao")

  participantes PeladeiroEvento[] // Relacionamento reverso com a Entidade PeladeiroEvento, retornando os N relacionamento com Peladeiros e Eventos

  caixaMovimentacoes CaixaMovimentacao[] // Relacionamento reverso com a Entidade CaixaMovimentacao, retornando os N movimentações financeiras do evento

  @@map("eventos")
}

enum StatusPeladeiroEvento {
  ESCALAVEL
  NAO_ESCALAVEL
}

/**
 * Relacionamento entre o peladeiro e o evento.
 * Basicamente é a relação da órdem de chegada dos peladeiros no evento.
 */
model PeladeiroEvento {
  id              Int                   @id @default(autoincrement())
  peladeiroId     Int                   @map("peladeiro_id")
  eventoId        Int                   @map("evento_id")
  status          StatusPeladeiroEvento @default(ESCALAVEL)
  registroEntrada DateTime              @map("registro_entrada")
  registroSaida   DateTime?             @map("registro_saida")
  dataCadastro    DateTime              @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime              @updatedAt @map("data_atualizacao")

  peladeiro Peladeiro @relation(fields: [peladeiroId], references: [id]) // Definição de relacionamento com a Entidade Peladeiro
  evento    Evento    @relation(fields: [eventoId], references: [id]) // Definição de relacionamento com a Entidade Evento

  times PeladeiroEventoTime[] // Relacionamento reverso com a Entidade PeladeiroEventoTime, retornando os N relacionamentos com PeladeiroEventoTime, que dá acesso aos times em que o jogador foi escalado

  @@unique([peladeiroId, eventoId])
  @@index([peladeiroId])
  @@index([eventoId])
  @@map("peladeiro_eventos")
}

enum TipoCaixaMovimentacao {
  ENTRADA
  SAIDA
}

enum StatusCaixaMovimentacao {
  PENDENTE
  PAGO
}

/**
 * Tabela que armazena as movimentações do caixa da pelada.
 * Toda movimentação de caixa deve estar relacionada a um evento e seu respectivo peladeiro responsável.
 */
model CaixaMovimentacao {
  id               Int                     @id @default(autoincrement())
  eventoId         Int                     @map("evento_id") // Evento que deu origem à movimentação
  peladeiroId      Int                     @map("peladeiro_id") // Responsável pela movimentação
  tipo             TipoCaixaMovimentacao
  status           StatusCaixaMovimentacao @default(PENDENTE) // Status da movimentação será alterado após a confirmação do pagamento
  descricao        String                  @db.VarChar(255)
  valor            Decimal                 @db.Decimal(10, 2)
  dataMovimentacao DateTime                @map("data_movimentacao")
  dataCadastro     DateTime                @default(now()) @map("data_cadastro")
  dataAtualizacao  DateTime                @updatedAt @map("data_atualizacao")

  peladeiro Peladeiro @relation(fields: [peladeiroId], references: [id]) // Definição de relacionamento com a Entidade Peladeiro
  evento    Evento    @relation(fields: [eventoId], references: [id]) // Definição de relacionamento com a Entidade Evento

  recursoMaterial RecursoMaterial? // Relacionamento reverso com a Entidade RecursoMaterial, retornando o recurso material, quando houver, que originou a movimentação do caixa

  @@map("caixa_movimentacoes")
}

enum StatusMaterial {
  NOVO
  BOM
  REGULAR
  MANUTENCAO
  EXTRAVIADO
  BAIXADO
}

enum OrigemRecursoMaterial {
  AQUISICAO
  DOACAO
}

/**
 * Tabela que armazena os materiais da pelada.
 */
model RecursoMaterial {
  id                  Int                   @id @default(autoincrement())
  nome                String                @db.VarChar(150)
  descricao           String                @db.VarChar(255)
  status              StatusMaterial?
  origem              OrigemRecursoMaterial @default(AQUISICAO)
  caixaMovimentacaoId Int?                  @unique @map("caixa_movimentacao_id")
  dataIncorporacao    DateTime              @map("data_incorporacao")
  dataCadastro        DateTime              @default(now()) @map("data_cadastro")
  dataAtualizacao     DateTime              @updatedAt @map("data_atualizacao")

  caixaMovimentacao CaixaMovimentacao? @relation(fields: [caixaMovimentacaoId], references: [id]) // Definição de relacionamento com a Entidade CaixaMovimentacao

  @@map("recursos_materials")
}

/**
 * Representa a lista de times do evento.
 */
model Time {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique @default(uuid()) @map("public_id") @db.Uuid
  nome            String   @db.VarChar(50)
  imagem          String?  @db.VarChar(500)
  dataCadastro    DateTime @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  jogadores PeladeiroEventoTime[] // Relacionamento reverso com a Entidade PeladeiroEventoTime, retornando os N relacionamentos com PeladeiroEventoTime, que dá acesso à PelaceiroEvento, que dá acesso ao Peladeiro
  partidas  PartidaTime[] // Relacionamento reverso com a Entidade PartidaTime, retornando os N relacionamentos com PartidaTime, que dá acesso às Partidas e aos times, respectivamente

  @@map("times")
}

/**
 * Tabela que relaciona os peladeiros do evento com seus respectivos times durante o evento.
 * O peladeiro poder ser escalado em vários times durante o evento. Mas em apenas um time ativo por vez.
 */
model PeladeiroEventoTime {
  id                Int      @id @default(autoincrement())
  timeId            Int      @map("time_id")
  peladeiroEventoId Int      @map("peladeiro_evento_id")
  dataCadastro      DateTime @default(now()) @map("data_cadastro")
  dataAtualizacao   DateTime @updatedAt @map("data_atualizacao")

  peladeiroEvento PeladeiroEvento @relation(fields: [peladeiroEventoId], references: [id]) // Definição de relacionamento com a Entidade PeladeiroEvento
  time            Time            @relation(fields: [timeId], references: [id]) // Definição de relacionamento com a Entidade Time

  @@map("peladeiro_evento_times")
}

enum StatusPartida {
  AGUARDANDO
  PAUSADA
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

model Partida {
  id              Int           @id @default(autoincrement())
  publicId        String        @unique @default(uuid()) @map("public_id") @db.Uuid
  eventoId        Int           @map("evento_id")
  status          StatusPartida @default(AGUARDANDO)
  inicio          DateTime?
  fim             DateTime?
  duracaoMinutos  Int?          @map("duracao_minutos")
  dataCadastro    DateTime      @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime      @updatedAt @map("data_atualizacao")

  confronto PartidaTime[] // Relacionamento reverso com a Entidade PartidaTime, dando acesso aos times da partida

  @@index([eventoId])
  @@map("partidas")
}

enum OpcoesCorColete {
  AZUL
  PRETO
}

model PartidaTime {
  id          Int             @id @default(autoincrement())
  partidaId   Int             @map("partida_id")
  timeId      Int             @map("time_id")
  corDoColete OpcoesCorColete @map("cor_do_colete")

  partida Partida @relation(fields: [partidaId], references: [id]) // Definição de relacionamento com a Entidade Partida
  time    Time    @relation(fields: [timeId], references: [id]) // Definição de relacionamento com a Entidade Time

  @@unique([partidaId, timeId])
  @@unique([partidaId, corDoColete])
  @@index([timeId])
  @@map("partidas_times")
}

model Gol {
  id              Int      @id @default(autoincrement())
  dataCadastro    DateTime @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  @@map("gols")
}
